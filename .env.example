# Скопируйте в .env (или дайте deploy/vault/setup.sh сгенерировать его).
# .env читается scripts/deploy.sh и передаётся в vals / helm-secrets.

# Адрес Vault с машины, откуда идёт деплой (Ingress vault.local -> 127.0.0.1 через minikube tunnel)
VAULT_ADDR=https://vault.local
# Локальный self-signed CA. В облаке вместо этого VAULT_CACERT=/path/to/ca.crt
VAULT_SKIP_VERIFY=true

# AppRole healthchecks (policy healthchecks-read) — выдаёт deploy/vault/setup.sh
VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=
VAULT_SECRET_ID=
